# NULLXES BLACK DEATH — .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
venv/
06_autonomy/models/cerber_v2/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ROS 2 / colcon
build/
install/
log/
*.pcd

# Models / weights / engines
*.onnx
*.pt
*.pth
*.engine
*.pkl
*.h5
!06_autonomy/models/**/.gitkeep

# Datasets / media (train data never in git)
datasets/
**/datasets/
**/sources/
runs/
wandb/
ultralytics/
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tif
*.tiff
*.gif
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.incomplete
*.lock
!00_docs/**/*.png
!00_docs/**/*.jpg
!06_autonomy/models/cerber_v2/exports/**
# keep plots/metrics in exports; do not grow repo with weight dumps
06_autonomy/models/cerber_v2/exports/**/*.pt
06_autonomy/models/cerber_v2/exports/**/*.onnx
!99_tools/**/*.md

# Labels / YOLO trees generated locally
**/images/
**/labels/
!**/images/.gitkeep
!**/labels/.gitkeep

# HF / local caches
.cache/
**/.cache/
**/hf_cache/
*.arrow
*.parquet

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Sim / CFD / FEA dumps
*.vtk
*.vtu
*.msh
*.cas
*.dat
*.rst
*.frd
*.odb
*.log

# Local ArduPlane kit binaries / MSI extract (MANIFEST + parm + json stay in git)
*.msi
arduiplane/*.apj
arduiplane/_mp_extract/
arduiplane/_apm.pdef.json

# Secrets
.env
*.pem
credentials*
